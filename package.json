  "description": "assessment",
  "main": "index.js",
  "scripts": {
    "start": "node dist/index.js",
    "build": "tsc",
    "dev": "ts-node-dev src/index.ts",
    "migration:generate": "typeorm-ts-node-esm migration:generate",
    "migration:run": "typeorm-ts-node-esm migration:run",
    "migration:revert": "typeorm-ts-node-esm migration:revert",
    "migration:show": "typeorm-ts-node-esm migration:show",
    "migration:create": "typeorm-ts-node-esm migration:create",
    "typeorm": "ts-node-esm -r tsconfig-paths/register ./node_modules/typeorm/cli",
    "typeorm-ts-node-esm": "ts-node-esm -r tsconfig-paths/register ./node_modules/typeorm/cli",
    "typeorm-ts-node": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli",
    "typeorm-ts-node-dev": "ts-node-dev -r tsconfig-paths/register ./node_modules/typeorm/cli",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "dependencies": {
    "@apollo/server": "^4.9.5",
    "apollo-server-express": "3.13.0",
    "argon2": "^0.31.2",
    "class-validator": "^0.14.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.11.3",
    "reflect-metadata": "^0.1.13",
    "type-graphql": "2.0.0-rc.2",
    "typeorm": "^0.3.17",
    "@apollo/client": "^3.8.6",
    "next": "^13.4.19",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "graphql": "^16.8.1",
    "react-hook-form": "^7.47.0",
    "tailwindcss": "^3.3.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.20",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/node": "^20.5.7",
    "ts-node-dev": "^2.0.0",
    "typeorm-extension": "^2.0.0",
    "typescript": "^5.2.2"
  },
